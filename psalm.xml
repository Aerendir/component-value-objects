<?xml version="1.0"?>
<psalm
    phpVersion="8.2"
    cacheDirectory="./var/cache/psalm"
    checkForThrowsDocblock="true"
    hideExternalErrors="true"
    ignoreInternalFunctionNullReturn="false"
    ignoreInternalFunctionFalseReturn="false"
    strictBinaryOperands="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="vendor-bin/phpunit/vendor/vimeo/psalm/config.xsd"
    errorBaseline=".baseline-psalm.xml"
    findUnusedCode="false"
>
    <projectFiles>
        <directory name="src"/>
        <directory name="tests"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <MissingThrowsDocblock errorLevel="suppress" />
        <RedundantCondition errorLevel="suppress" />
        <RedundantConditionGivenDocblockType errorLevel="suppress" />
        <RedundantIdentityWithTrue errorLevel="suppress" />

        <!-- The #[\Override] attribute exists only from PHP 8.3, and this library supports PHP 8.2 -->
        <MissingOverrideAttribute errorLevel="suppress" />

        <!-- Specific to this library -->
        <!-- AddressEmbeddable is meant to be extended by the applications that use it -->
        <ClassMustBeFinal errorLevel="suppress" />
        <ImplicitToStringCast errorLevel="suppress" />
        <MoreSpecificImplementedParamType errorLevel="suppress" />
        <ParamNameMismatch errorLevel="suppress" />
        <PropertyNotSetInConstructor errorLevel="suppress" />
    </issueHandlers>
    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
    </plugins>
</psalm>
